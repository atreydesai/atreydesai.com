{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.atreydesai.com"
        }
      ],
      "destination": "https://atreydesai.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/media-list",
      "destination": "https://atreydesai.com/bookshelf/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    }
  ]
}
