{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.atreydesai.com"
        }
      ],
      "destination": "https://atreydesai.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/media-list",
      "destination": "https://atreydesai.com/bookshelf/",
      "permanent": true
    }
  ]
}
