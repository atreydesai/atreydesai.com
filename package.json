{
  "name": "atreydesai.com",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "optimize-photos": "node scripts/optimize-photos.mjs",
    "sync:goodreads": "node scripts/sync-goodreads.mjs",
    "sync:mdl": "node scripts/sync-mdl.mjs",
    "tags:backfill": "node scripts/backfill-tags.mjs",
    "categories:backfill": "node scripts/backfill-categories.mjs",
    "build": "npm run optimize-photos && npm run sync:goodreads && npm run sync:mdl && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-check --tsconfig ./jsconfig.json --watch",
    "lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. .",
    "format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. .",
    "postinstall": "patch-package && svelte-kit sync"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.18",
    "js-yaml": "^4.2.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.35",
    "prettier": "3.2.5",
    "sharp": "^0.34.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0",
    "vite": "^8.0.13"
  },
  "type": "module",
  "dependencies": {
    "@jis3r/icons": "^2.7.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@rollup/pluginutils": "^5.1.0",
    "@types/js-yaml": "^4.0.9",
    "@vercel/analytics": "^1.2.2",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^1.3.1",
    "exifreader": "^4.33.1",
    "lucide-svelte": "^0.344.0",
    "marked": "^12.0.0"
  }
}
