{
  "name": "atreydesai.com",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "optimize-photos": "node scripts/optimize-photos.mjs",
    "upload-photos": "node scripts/upload-photos.mjs",
    "og": "node scripts/og.mjs",
    "lab": "node scripts/perf-lab.mjs",
    "sync:goodreads": "node scripts/sync-goodreads.mjs",
    "sync:mdl": "node scripts/sync-mdl.mjs",
    "sync:letterboxd": "node scripts/sync-letterboxd.mjs",
    "build": "npm run optimize-photos && npm run sync:goodreads && npm run sync:mdl && npm run sync:letterboxd && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-check --tsconfig ./jsconfig.json --watch",
    "postinstall": "svelte-kit sync"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.1",
    "@rollup/pluginutils": "^5.1.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hyphen": "^1.14.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "exifreader": "^4.33.1",
    "js-yaml": "^5.5.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.13"
  },
  "type": "module",
  "dependencies": {
    "@jis3r/icons": "^2.7.0",
    "@kitlangton/justice": "^0.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^2.1.0",
    "gsap": "^3.15.0",
    "hyphen": "^1.14.1",
    "marked": "^18.2.1",
    "turndown": "^7.2.4"
  },
  "engines": {
    "node": "26.x"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "@vercel/analytics": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  }
}
